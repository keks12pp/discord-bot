# Discord Bot Token
# Dapatkan token dari https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# OpenAI API Key (untuk AI-powered conversation)
# Untuk OpenAI API atau layanan OpenAI-compatible seperti Dashscope/DeepSeek
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Base URL (opsional, untuk layanan OpenAI-compatible seperti Dashscope)
OPENAI_BASE_URL=https://api.openai.com/v1

# OpenAI Model (opsional, default: gpt-4o-mini)
OPENAI_MODEL=deepseek-v4-pro

# Voice Channel ID (opsional) - Bot akan auto join voice channel saat start
AUTO_VOICE_CHANNEL_ID=

# Channel ID di mana bot akan auto chat
AUTO_CHAT_CHANNEL_ID=your_channel_id_here

# Interval auto chat dalam detik (default: 60)
AUTO_CHAT_INTERVAL=60

# AI Provider (opsional, default: openai)
AI_PROVIDER=openai

# Bot Name (opsional, default: linux)
BOT_NAME=linux

# Personality bot (opsional)
BOT_PERSONALITY=casual friendly Indonesian person who knows many topics, likes to join conversations, and responds naturally like a real person

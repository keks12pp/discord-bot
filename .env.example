# Discord Bot Token
# Dapatkan token dari https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Channel ID di mana bot akan auto chat
AUTO_CHAT_CHANNEL_ID=your_channel_id_here

# Interval auto chat dalam detik (default: 60)
AUTO_CHAT_INTERVAL=60

# OpenAI API Key (untuk AI-powered conversation)
# Dapatkan dari https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Personality bot (opsional, default: casual friendly person)
BOT_PERSONALITY=casual friendly Indonesian person who knows many topics, likes to join conversations, and responds naturally like a real person
